{
  "name": "sia-central-lite-wallet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite",
    "dev:testnet": "npm run build:wasm:testnet && vite",
    "serve": "npm run dev --",
    "build": "npm run build:wasm && npm run build:vue --",
    "build:testnet": "npm run build:wasm:testnet && npm run build:vue --",
    "build:wasm": "node scripts/build.js wasm",
    "build:wasm:testnet": "node scripts/build.js wasm --testnet",
    "build:vue": "vite build",
    "docker": "node scripts/build.js docker",
    "preview": "vite preview",
    "lint": "npm run lint:go && npm run lint:js --",
    "lint:go": "GOOS=js GOARCH=wasm golangci-lint run ./wasm/...",
    "lint:js": "eslint . --fix",
    "test": "npm run test:js && npm run test:go",
    "test:js": "vitest run",
    "test:go": "go test ./wasm/internal/...",
    "prepare": "husky"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@ledgerhq/hw-transport-web-ble": "^6.35.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/logs": "^6.19.0",
    "@siacentral/ledgerjs-sia": "^2.0.2",
    "@stablelib/base64": "^2.0.1",
    "@stablelib/utf8": "^2.1.0",
    "bignumber.js": "^11.1.5",
    "buffer": "^6.0.3",
    "dexie": "^4.4.7",
    "tweetnacl": "^1.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "stylus": "^0.64.0",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint --fix"
  }
}
